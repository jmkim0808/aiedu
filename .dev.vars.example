# 로컬 개발용 환경변수 예시.
# 이 파일을 .dev.vars 로 복사해서 실제 값을 넣는다. .dev.vars 는 커밋되지 않는다.

# ROLE_MAP: 이메일 -> 역할코드 배열.
#   이 매핑은 여기(운영에서는 wrangler secret)에만 존재하며 데이터베이스에 저장하지 않는다.
#   Worker 는 Access 가 넘겨준 이메일을 역할코드로 바꾼 직후 버린다.
#
#   역할코드는 설계문서의 권한 정의를 반영해서 확정한다. 아래는 형식 예시일 뿐이다.
ROLE_MAP={"lead@powernet.co.kr":["HQ_LEAD","HQ_ADMIN"],"user@powernet.co.kr":["HQ_USER"]}

# 로컬에는 Cloudflare Access 가 없으므로 false 로 둔다.
# 운영 배포에는 절대 false 를 올리지 않는다.
REQUIRE_ACCESS=false
